# ─── REQUIRED ─────────────────────────────────────────────────────────────────
#
# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
# Network access → allow 0.0.0.0/0 (or Vercel IP range)
# Database access → create a user with readWrite on "crypgo" database
# Connect → Drivers → copy the SRV connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crypgo?retryWrites=true&w=majority

# ─── REQUIRED FOR PRODUCTION FILE STORAGE ─────────────────────────────────────
#
# Vercel Blob token — created automatically when you add Blob storage to your
# Vercel project:  Project → Storage → Create → Blob Store
# Then copy the BLOB_READ_WRITE_TOKEN from the .env tab.
# Without this, files are stored locally (dev only — not suitable for production).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<token>

# ─── REQUIRED FOR PRODUCTION ──────────────────────────────────────────────────
#
# Comma-separated list of your production + preview origins.
# Example: https://your-app.vercel.app,https://yourCustomDomain.com
# Leave empty in .env.local for local dev (all origins allowed).
ALLOWED_ORIGINS=https://your-app.vercel.app

# ─── OPTIONAL: SOLANA / ARWEAVE ───────────────────────────────────────────────
#
# Platform wallet private key (base58) — used as Metaplex update authority when
# building mint transactions. Gift storage is paid by the minter via Phantom.
# ⚠️  ROTATE THIS KEY if it was ever committed to git or shared.
ARWEAVE_SOLANA_KEY=<base58-private-key>

# Metaplex Core Collection for gift mints (Phantom Collectibles — recommended).
# Create once: npm run setup:mainnet-collection
# CORE_COLLECTION_ADDRESS=<core-collection-pubkey>
# CORE_COLLECTION_ADDRESS_DEVNET=<devnet-collection-pubkey>
# CORE_COLLECTION_ADDRESS_MAINNET=hRiamu3d97ujzHZGCkSjwLNj5GQ5nVnMsmfJqgxB9v7
# CORE_COLLECTION_NAME=Dough Boi Gifts
# CORE_COLLECTION_URI=https://gateway.irys.xyz/...
#
# MongoDB id/slug for the bundled gift collection on /market (default: dough-boi-gifts)
# GIFT_BUNDLE_COLLECTION_ID=dough-boi-gifts
#
# Legacy Token Metadata gifts (maintenance scripts only — not used for new mints):
# GIFT_TM_COLLECTION_MINT=<collection-nft-mint-pubkey>
# GIFT_TM_COLLECTION_MINT_MAINNET=<mainnet-collection-nft-mint-pubkey>
# GIFT_COLLECTION_NAME=Dough Boi
# GIFT_COLLECTION_URI=https://arweave.net/your-collection-metadata.json

# Active cluster: devnet (testing) or mainnet (production)
SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_URL_MAINNET=https://api.mainnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET=https://api.mainnet.solana.com

# To go live: set SOLANA_NETWORK and NEXT_PUBLIC_SOLANA_NETWORK to `mainnet`
# and restart the dev server / redeploy.

# ─── OPTIONAL: SLICEPAY PAYMENTS ──────────────────────────────────────────────
#
# SlicePay merchant credentials from https://slicechain.io/dashboard
# If not set, the app runs in demo mode (no real payments).
SLICEPAY_MERCHANT_ID=<your-merchant-id>
SLICEPAY_API_KEY=<your-api-key>
